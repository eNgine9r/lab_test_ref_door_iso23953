[Unit]
Description=Door Test Controller Kiosk
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/door-test-system
Environment=SIMULATION_MODE=0
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=MODBUS_BACKEND=auto
Environment=OFFLINE_MODE=1
Environment=AUTO_OPEN_BROWSER=0
Environment=DISPLAY=:0
ExecStart=/home/pi/door-test-system/scripts/kiosk_start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
